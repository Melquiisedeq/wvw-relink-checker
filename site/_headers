# Read by Cloudflare, never served: wrangler leaves _headers out of the upload.

# The Content Security Policy is a header, never a <meta> in index.html:
# check-structure.py fails on a <meta> one, and a header also covers the document
# from its first byte and can say frame-ancestors, which a <meta> cannot.
#
# script-src and style-src 'self', no unsafe-inline: every script comes from js/,
# and styles set from JS go through the CSSOM. One script comes from elsewhere,
# named down to its path: Cloudflare Web Analytics' beacon.
#
# connect-src: this site's /api, the GW2 API, Google Sheets (three read-only
# sheets on one host: the community guild list, this project's kills history,
# and the cell saying whether the new teams are out) and the Analytics collector.
#
# img-src: local files, plus guild emblems from ArenaNet's asset host.
#
# check-structure.py reads the policy from the line below; check-site.py compares
# it with what wvwrelink.com serves.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js; style-src 'self'; connect-src 'self' https://api.guildwars2.com https://docs.google.com https://cloudflareinsights.com; img-src 'self' https://render.guildwars2.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000
