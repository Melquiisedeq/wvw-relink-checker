// The site as a Cloudflare Worker made only of static files: no `main`, so no
// code of ours runs there. Read by Cloudflare's build only. Only site/ is
// uploaded, so nothing outside it can be published by accident.
{
  // Must match the Worker's name in the dashboard, or the build fails.
  "name": "wvwrelink",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "site"
  },
  // The site lives at wvwrelink.com; workers.dev would be a second copy.
  // Turning it off also turns off version URLs unless they are named here,
  // and those are where branch previews live.
  "workers_dev": false,
  "preview_urls": true,
  // Required by Worker previews, even when empty.
  "previews": {}
}
