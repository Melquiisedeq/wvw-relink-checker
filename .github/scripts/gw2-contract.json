{
  "_doc": "What the page reads from each api.guildwars2.com route (site/js/). Types: str, num (int or float), bool, null, joined by |. [x] is a list whose every item is x; {\"*\": x} an object keyed by arbitrary ids. A key ending in ? may be absent. Only fields the page reads are listed.",
  "routes": [
    {"route": "/wvw/timers/lockout", "read_in": "site/js/relink.js",
     "shape": {"na": "str", "eu?": "str"}},
    {"route": "/wvw/timers/teamAssignment", "read_in": "site/js/relink.js",
     "shape": {"na": "str", "eu": "str"}},
    {"route": "/wvw/matches?ids=all", "read_in": "site/js/standings.js",
     "shape": "$match_list"},
    {"route": "/wvw/matches?id=1-1", "read_in": "site/js/maps.js",
     "recorded": "/wvw/matches?id=1-1",
     "shape": "$match"},
    {"route": "/wvw/objectives?ids=all", "read_in": "site/js/maps.js",
     "shape": [{"id": "str", "name": "str", "type": "str", "map_type": "str",
                "map_id": "num", "sector_id?": "num", "upgrade_id?": "num",
                "coord?": ["num"], "label_coord?": ["num"]}]},
    {"route": "/wvw/upgrades?ids=all", "read_in": "site/js/maps.js",
     "shape": [{"id": "num",
                "tiers": [{"name": "str", "yaks_required": "num",
                           "upgrades": [{"name": "str", "description": "str", "icon": "str"}]}]}]},
    {"route": "/guild/upgrades?ids=222", "read_in": "site/js/maps.js",
     "shape": [{"id": "num", "name": "str", "description": "str", "icon": "str"}]},
    {"route": "/guild/upgrades?ids=583,147,483,513,590,306,168,298,562,178,418,329,389,183",
     "read_in": "site/js/maps.js",
     "shape": [{"id": "num", "name": "str", "description": "str", "icon": "str"}]},
    {"route": "/emblem/backgrounds?ids=all", "read_in": "site/js/maps.js",
     "shape": [{"id": "num", "layers": ["str"]}]},
    {"route": "/emblem/foregrounds?ids=all", "read_in": "site/js/maps.js",
     "shape": [{"id": "num", "layers": ["str"]}]},
    {"route": "/continents/2/floors/3/regions/7/maps/38/sectors?ids=all", "read_in": "site/js/maps.js",
     "shape": "$sectors"},
    {"route": "/continents/2/floors/3/regions/7/maps/1099/sectors?ids=all", "read_in": "site/js/maps.js",
     "shape": "$sectors"},
    {"route": "/continents/2/floors/3/regions/7/maps/95/sectors?ids=all", "read_in": "site/js/maps.js",
     "shape": "$sectors"},
    {"route": "/continents/2/floors/3/regions/7/maps/96/sectors?ids=all", "read_in": "site/js/maps.js",
     "shape": "$sectors"},
    {"route": "/wvw/guilds/na", "read_in": "site/js/api.js",
     "shape": {"*": "str"}},
    {"route": "/wvw/guilds/eu", "read_in": "site/js/api.js",
     "shape": {"*": "str"}},
    {"route": "/guild/search?name=$guild", "read_in": "site/js/api.js",
     "shape": ["str"]},
    {"route": "/guild/$guildId", "read_in": "site/js/api.js",
     "shape": {"id": "str", "name": "str", "tag": "str",
               "emblem": {"background": {"id": "num", "colors": ["num"]},
                          "foreground": {"id": "num", "colors": ["num"]},
                          "flags": ["str"]}}}
  ],
  "defs": {
    "colors": {"red": "num", "blue": "num", "green": "num"},
    "sectors": [{"id": "num", "name": "str", "coord": ["num"], "bounds": [["num"]]}],
    "match": {
      "id": "str", "start_time": "str", "end_time": "str",
      "scores": "$colors", "kills": "$colors", "deaths": "$colors",
      "victory_points": "$colors",
      "all_worlds": {"red": ["num"], "blue": ["num"], "green": ["num"]},
      "skirmishes": [{"id": "num", "scores": "$colors",
                      "map_scores": [{"type": "str", "scores": "$colors"}]}],
      "maps": [{"id": "num", "type": "str", "scores": "$colors",
                "kills": "$colors", "deaths": "$colors",
                "objectives": [{"id": "str", "type": "str", "owner": "str",
                                "last_flipped": "str", "points_tick": "num",
                                "points_capture": "num",
                                "claimed_by?": "str", "yaks_delivered?": "num",
                                "guild_upgrades?": ["num"]}]}]
    },
    "match_list": ["$match"]
  }
}
